{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "rootDir": ".",
    "outDir": "dist/app",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["index.ts", "config.ts", "src/**/*.js", "src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
